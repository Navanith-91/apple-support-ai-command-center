# Customer Support AI Agent Configuration
# Copy this file to .env and configure your environment variables

# Optional LLM API keys (System works with local TF-IDF / embeddings or LLM APIs)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Dataset & Storage paths (optional overrides)
RAW_DATA_PATH=data/raw/Customer_Support_on_Twitter.parquet
PROCESSED_DATA_DIR=data/processed
GOLDEN_SET_PATH=evaluation/golden_set.csv
INDEX_PATH=data/processed/retrieval_index.pkl

# Selected Brand
SELECTED_BRAND=AppleSupport

# Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LLM_PROVIDER=offline  # Options: offline, gemini, openai
LLM_MODEL=gemini-1.5-flash

# Logging
LOG_LEVEL=INFO
